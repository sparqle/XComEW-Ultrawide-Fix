#include <windows.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/ultrawide.ico"
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/cpp/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "XCOM: Enemy Within Ultrawide Fix\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "ProductName", "XComEW-Ultrawide-Fix\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "OriginalFilename", "XComEW-Ultrawide-Fix.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
